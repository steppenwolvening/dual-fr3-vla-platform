            "left.joint4.rad",
            "left.joint5.rad",
            "left.joint6.rad",
            "left.joint7.rad",
            "right.joint1.rad",
            "right.joint2.rad",
            "right.joint3.rad",
            "right.joint4.rad",
            "right.joint5.rad",
            "right.joint6.rad",
            "right.joint7.rad",
            "left.opening_width.m",
            "right.opening_width.m"
