        "memory_frames": 6,
        "memory_stride": 30,
        "memory_temporal_attention_every": 4,
        "max_state_dim": 32,
        "max_action_dim": 32,
        "num_inference_steps": 10,
        "time_sampling_beta_alpha": 1.5,
